#!/usr/bin/env bash
# Runs a command inside the ROOT flake's pinned shell with console-owned build/deps paths (no lock drift).
#   bin/env mix test
set -eu
here=$(cd "$(dirname "$0")/.." && pwd); root=$(cd "$here/.." && pwd); tag=elixir-1.20.4-otp-29.0.5
cd "$here"
exec nix develop "$root" --command env -u MIX_BUILD_PATH MIX_BUILD_ROOT="$here/_build/$tag" MIX_DEPS_PATH="$here/deps/$tag" "$@"

# Console-owned development entrypoint: the ROOT flake's pinned toolchain (no second lock), with the build and
# dependency paths overridden to console-owned directories (the flake derives them from the Git root).
use flake ..
tag=elixir-1.20.4-otp-29.0.5
export MIX_BUILD_ROOT="$PWD/_build/$tag"
export MIX_DEPS_PATH="$PWD/deps/$tag"
unset MIX_BUILD_PATH

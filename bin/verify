#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

if [[ $# -ne 0 ]]; then
  printf 'usage: bin/verify\n' >&2
  exit 2
fi

required_elixir="1.20.4"
required_otp="29.0.5"

actual_elixir="$(elixir -e 'IO.write(System.version())')"
actual_otp="$(
  elixir -e '
    release = :erlang.system_info(:otp_release) |> List.to_string()
    path = Path.join([List.to_string(:code.root_dir()), "releases", release, "OTP_VERSION"])
    path |> File.read!() |> String.trim() |> IO.write()
  '
)"

if [[ "$actual_elixir" != "$required_elixir" || "$actual_otp" != "$required_otp" ]]; then
  printf 'toolchain mismatch: expected Elixir %s / OTP %s, got Elixir %s / OTP %s\n' \
    "$required_elixir" "$required_otp" "$actual_elixir" "$actual_otp" >&2
  printf 'run verification through: nix develop --command bin/verify\n' >&2
  exit 1
fi

printf 'verification profile: %s (Elixir %s / OTP %s)\n' \
  "adopted" "$actual_elixir" "$actual_otp"

bin/check-documentation-format
bash test/documentation_format_test.sh

mix deps.get --check-locked
# Hex and mix_audit use distinct advisory sources. Run both so a clean result
# from one cannot silently mask an advisory published by the other.
mix hex.audit
test/redaction_check_test.sh
test/dialyzer_baseline_test.sh
bin/redaction-check
mix format --check-formatted
mix compile --warnings-as-errors
mix test --warnings-as-errors
mix boundary.spec >/dev/null

# The escript gate is `mix test` above, in test/contracts/production_escript_test.exs. It
# builds the PRODUCTION artifact into a freshly created, asserted-empty build directory,
# launches it as an OS process that really opens a journal writer, pins the packaged
# inventory, and carries the three controls this script used to own: stderr may never
# carry the result, the OTLP exporter may never lose its startup race with :inets, and
# the working tree must be as it was found (PE-3, PE-8). This script used to build a
# SECOND escript here -- in the dev environment, not prod -- and re-probe it by hand, so
# every gate run paid for two escript builds and the hand-written one measured the
# artifact that does not ship.
#
# Gate C purity: the pure reducer may reference no effect adapter, clock, id seam, process, or file.
reducer_source="lib/ai_orchestrator/lifecycle/core/reducer.ex"
if [[ -f "$reducer_source" ]]; then
  reducer_hits="$(bin/capture-rg 'reducer purity' -n 'AiOrchestrator\.Dispatch\b|\bDispatch\.[a-z]|\bGate\.|\bGateRunner\b|\bPaneRegistry\b|\bNotify\b|\bFile\.|\bSystem\.|Process\.sleep|:timer|\bclock\.|\bSystemClock\b|\bSystemId\b|\bAgent\.|\bGenServer\b|\bsend\(|\breceive\b|\bevent_sink\b' "$reducer_source")"
  if [[ -n "$reducer_hits" ]]; then
    printf 'reducer purity gate failed:\n%s\n' "$reducer_hits" >&2
    exit 1
  fi
fi
mix credo --strict
mix deps.audit
bin/dialyzer-check

legacy_word="legacy""-bash"
legacy_hits="$(bin/capture-rg 'legacy archive vocabulary' -n "$legacy_word" --glob '!docs/history.org' --glob '!deps/**' --glob '!_build/**' .)"
if [[ -n "$legacy_hits" ]]; then
  printf 'forbidden legacy archive references outside docs/history.org:\n%s\n' "$legacy_hits" >&2
  exit 1
fi

bin/check-product-name
bash test/check_product_name_test.sh

if [[ -d lib ]]; then
  vocab_hits="$(bin/capture-rg 'prototype domain vocabulary' -n 'task_id|round_' lib)"
  if [[ -n "$vocab_hits" ]]; then
    printf 'forbidden prototype domain vocabulary in lib/:\n%s\n' "$vocab_hits" >&2
    exit 1
  fi
fi
